# Environment Configuration for Docker Compose

# Application
NODE_ENV=production

# Backend API
PORT=4000
WS_PORT=4001

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4001
VITE_CHAIN_ID=42161
VITE_CHAIN_NAME=Arbitrum One

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hyperliquid
DB_USER=hyperliquid
DB_PASSWORD=hyperliquid_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_secret_in_production_use_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
